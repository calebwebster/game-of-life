@page "/"
@rendermode InteractiveServer
@using System.Threading
@implements IDisposable

<PageTitle>Conway's Game of Life</PageTitle>

<div class="d-flex justify-content-center">
  <div class="border">
    @for (int row = 0; row < Rows; row++)
    {
      <div class="d-flex">
        @for (int col = 0; col < Cols; col++)
        {
          int r = row;
          int c = col;
          <div class="border @(Grid[row, col] ? "bg-black" : "bg-white")"
               style="width: 16px; height: 16px; cursor: pointer;" @onclick="(() => Toggle(r, c))">
          </div>
        }
      </div>
    }
  </div>
</div>
<div class="d-flex justify-content-center mt-3">
  <button class="btn btn-primary mx-2" @onclick="Tick">Tick</button>
  @if (!isPlaying)
  {
    <button class="btn btn-primary mx-2" @onclick="Play">Play</button>
  }
  else
  {
    <button class="btn btn-primary mx-2" @onclick="Pause">Pause</button>
  }
  <button class="btn btn-primary mx-2" @onclick="Reset">Reset</button>
</div>

@code {
  private const int Rows = 32;
  private const int Cols = 32;

  private bool[,] Grid { get; set; } = new bool[Rows, Cols];

  private bool[,] NewGrid { get; set; } = new bool[Rows, Cols];

  private void Toggle(int row, int col)
  {
    Grid[row, col] = !Grid[row, col];
  }

  private void Reset()
  {
    for (int row = 0; row < Rows; row++)
    {
      for (int col = 0; col < Cols; col++)
      {
        Grid[row, col] = false;
      }
    }
  }

  private void Tick()
  {
    for (int row = 0; row < Rows; row++)
    {
      for (int col = 0; col < Cols; col++)
      {
        NewGrid[row, col] = Grid[row, col];
      }
    }

    for (int row = 0; row < Rows; row++)
    {
      for (int col = 0; col < Cols; col++)
      {
        bool cell = Grid[row, col];
        bool? NeighbourTopLeft = (row > 0 && col > 0) ? Grid[row - 1, col - 1] : null;
        bool? NeighbourTopMiddle = (row > 0) ? Grid[row - 1, col] : null;
        bool? NeighbourTopRight = (row > 0 && col < Grid.GetUpperBound(1)) ? Grid[row - 1, col + 1] : null;
        bool? NeighbourMiddleLeft = (col > 0) ? Grid[row, col - 1] : null;
        bool? NeighbourMiddleRight = (col < Grid.GetUpperBound(1)) ? Grid[row, col + 1] : null;
        bool? NeighbourBottomLeft = (row < Grid.GetUpperBound(0) && col > 0) ? Grid[row + 1, col - 1] : null;
        bool? NeighbourBottomMiddle = (row < Grid.GetUpperBound(0)) ? Grid[row + 1, col] : null;
        bool? NeighbourBottomRight = (row < Grid.GetUpperBound(0) && col < Grid.GetUpperBound(0)) ? Grid[row + 1, col + 1] :
null;

        int NumLiveNeighbours = 0;

        if (NeighbourTopLeft ?? false)
        {
          NumLiveNeighbours++;
        }

        if (NeighbourTopMiddle ?? false)
        {
          NumLiveNeighbours++;
        }

        if (NeighbourTopRight ?? false)
        {
          NumLiveNeighbours++;
        }

        if (NeighbourMiddleLeft ?? false)
        {
          NumLiveNeighbours++;
        }

        if (NeighbourMiddleRight ?? false)
        {
          NumLiveNeighbours++;
        }

        if (NeighbourBottomLeft ?? false)
        {
          NumLiveNeighbours++;
        }

        if (NeighbourBottomMiddle ?? false)
        {
          NumLiveNeighbours++;
        }

        if (NeighbourBottomRight ?? false)
        {
          NumLiveNeighbours++;
        }

        @* Any live cell with fewer than two live neighbours dies, as if by underpopulation. *@
        if (cell && NumLiveNeighbours < 2)
        {
          NewGrid[row, col] = false;
        }

        @* Any live cell with two or three live neighbours lives on to the next generation. *@
        if (cell && (NumLiveNeighbours == 2 || NumLiveNeighbours == 3))
        {
          @* Nothing *@
        }

        @* Any live cell with more than three live neighbours dies, as if by overpopulation. *@
        if (cell && NumLiveNeighbours > 3)
        {
          NewGrid[row, col] = false;
        }

        @* Any dead cell with exactly three live neighbours becomes a live cell, as if by reproduction. *@
        if (!cell && NumLiveNeighbours == 3)
        {
          NewGrid[row, col] = true;
        }
      }
    }

    for (int row = 0; row < Rows; row++)
    {
      for (int col = 0; col < Cols; col++)
      {
        Grid[row, col] = NewGrid[row, col];
      }
    }
  }

  private bool isPlaying = false;
  private Task? _timerTask;
  private CancellationTokenSource? _cts;

  // Start a brand new background task loop
  private void Play()
  {
    if (_timerTask != null && !_timerTask.IsCompleted)
    {
      isPlaying = false;
      return;
    }
    _cts = new CancellationTokenSource();
    _timerTask = RunGameLoopAsync(_cts.Token);
    isPlaying = true;
  }

  // Completely kill the running task
  private void Pause()
  {
    if (_cts != null)
    {
      _cts.Cancel(); // This breaks the 'WaitForNextTickAsync' loop instantly
      _cts.Dispose();
      _cts = null;
    }
    isPlaying = false;
  }

  private async Task RunGameLoopAsync(CancellationToken token)
  {
    using PeriodicTimer timer = new(TimeSpan.FromMilliseconds(100));

    try
    {
      // The loop checks the token on every single tick
      while (await timer.WaitForNextTickAsync(token))
      {
        Tick();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (OperationCanceledException)
    {
      // The task ends gracefully here when Stop() is called
    }
  }

  public void Dispose()
  {
    Pause(); // Ensure everything is killed if they change pages
  }
}
